              "name": "helpNoteJerarquiaDashboard",
              "fill": "#5f6b7a",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Nota: Para leer la jerarquía del dashboard, sigue el orden de arriba hacia abajo y usa la sangría para identificar cada nivel.",
