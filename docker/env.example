# Environment Configuration Template for Financieramente
# This file is used as a template for creating environment files on the server

# Application Environment
NODE_ENV=qa

# Database Configuration
POSTGRES_USER=financieramente_user
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=financieramente_qa

# Database URLs for Prisma
DATABASE_URL=postgresql://financieramente_user:your_secure_password_here@postgres:5432/financieramente_qa
DIRECT_URL=postgresql://financieramente_user:your_secure_password_here@postgres:5432/financieramente_qa

# Next.js Public API URL
# For QA: https://negocios.qa.financieramentecu.co
# For Prod: https://negocios.financieramentecu.co
NEXT_PUBLIC_API_URL=http://localhost:3000

# Additional Environment Variables
NEXT_TELEMETRY_DISABLED=1
PORT=3000
HOSTNAME=0.0.0.0

# Security
JWT_SECRET=your_jwt_secret_here
ENCRYPTION_KEY=your_encryption_key_here

# NextAuth Configuration
# Generate a secure secret with: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=https://negocios.qa.financieramentecu.co

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# External Services (when configured)
# REDIS_URL=redis://redis:6379
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password