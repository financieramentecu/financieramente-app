# Environment Configuration Template for Financieramente
# This file is used as a template for creating environment files on the server
# Copy this file to .env or .env.local and fill in your actual values

# ============================================================================
# Application Environment
# ============================================================================
NODE_ENV=qa

# ============================================================================
# Database Configuration
# ============================================================================
POSTGRES_USER=financieramente_user
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=financieramente_qa

# Database URLs for Prisma
# DATABASE_URL is used for connection pooling (pgBouncer)
# DIRECT_URL is used for migrations and direct connections
DATABASE_URL=postgresql://financieramente_user:your_secure_password_here@postgres:5432/financieramente_qa
DIRECT_URL=postgresql://financieramente_user:your_secure_password_here@postgres:5432/financieramente_qa

# ============================================================================
# Next.js Configuration
# ============================================================================
# Public API URL (Build time variable - embedded in code)
# For QA: https://negocios.qa.financieramentecu.co
# For Prod: https://negocios.financieramentecu.co
# For Local: http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000

# Disable Next.js telemetry
NEXT_TELEMETRY_DISABLED=1

# Server Configuration
PORT=3000
HOSTNAME=0.0.0.0

# ============================================================================
# Security & Authentication
# ============================================================================
# JWT Secret (optional, for additional JWT authentication if needed)
JWT_SECRET=your_jwt_secret_here

# Encryption Key (optional, for data encryption if needed)
ENCRYPTION_KEY=your_encryption_key_here

# NextAuth Configuration
# REQUIRED in production/qa/staging. The app refuses to boot without this
# (a hardcoded fallback is NOT used — see src/lib/auth/auth-secret.ts).
# Generate a secure secret with: openssl rand -base64 32
# NextAuth v5 uses AUTH_SECRET, but also accepts NEXTAUTH_SECRET for compatibility
AUTH_SECRET=your_nextauth_secret_here
# Or alternatively:
# NEXTAUTH_SECRET=your_nextauth_secret_here

# NextAuth URL (base URL of the application, no trailing slash)
# For QA: https://negocios.qa.financieramentecu.co
# For Prod: https://negocios.financieramentecu.co
NEXTAUTH_URL=https://negocios.qa.financieramentecu.co

# Required behind Nginx reverse proxy so Auth.js trusts X-Forwarded-Host/Proto (fixes 403 on signin)
AUTH_TRUST_HOST=true

# Google OAuth Credentials
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ============================================================================
# Seed Data Configuration
# ============================================================================
# Password for the super-admin account created during initial DB seeding.
# REQUIRED: generate a strong per-deployment value (e.g. `openssl rand -base64 24`).
# Do NOT commit a real value and do NOT reuse across environments.
SUPER_ADMIN_PASSWORD=

# ============================================================================
# E2E Test Bypass (dev/test only)
# ============================================================================
# When set AND NODE_ENV=test, requests may bypass auth by sending
# x-test-auth: true + x-test-auth-token: <this value>.
# Leave empty in production/qa/staging — the bypass is then disabled entirely.
# E2E_TEST_AUTH_TOKEN=

# ============================================================================
# Email Configuration (SendGrid - Recommended)
# ============================================================================
# SendGrid API Key
# Get from: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here

# SendGrid From Email (must be verified in SendGrid)
SENDGRID_FROM_EMAIL=noreply@financieramente.com

# SendGrid From Name (optional, default: "Financieramente")
SENDGRID_FROM_NAME=Financieramente

# SendGrid Template ID (optional, can be passed per request)
SENDGRID_TEMPLATE_ID=d-7bddba2ac2ba49ff952c4c2c689d55b7

# ============================================================================
# Email Configuration (SMTP - Alternative to SendGrid)
# ============================================================================
# Only use if SendGrid is not configured
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password

# ============================================================================
# External Services (Optional)
# ============================================================================
# Redis URL (if using Redis for caching/sessions)
# REDIS_URL=redis://redis:6379

# External API Keys (if needed)
# EXTERNAL_API_KEY=your_api_key_here
