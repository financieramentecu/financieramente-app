{
	"name": "financieramente-app",
	"version": "1.17.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "eslint",
		"type-check": "tsc --noEmit",
		"test": "vitest",
		"test:unit": "vitest --config vitest.unit.config.ts --run",
		"test:unit:coverage": "vitest --config vitest.unit.config.ts --coverage --run",
		"test:integration": "vitest --config vitest.integration.config.ts --run",
		"test:integration:coverage": "vitest --config vitest.integration.config.ts --coverage --run",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:debug": "playwright test --debug",
		"test:e2e:headed": "playwright test --headed",
		"test:e2e:headless": "HEADLESS=true playwright test",
		"test:all": "npm run test:unit && npm run test:integration && npm run test:e2e",
		"test:watch": "vitest --watch",
		"test:ui": "vitest --ui",
		"test:snapshot": "vitest --run --reporter=verbose",
		"test:email": "tsx scripts/test-notifications.ts",
		"test:email:all": "tsx scripts/test-notifications.ts all",
		"test:email:preliquidacion": "tsx scripts/test-notifications.ts preliquidacion",
		"test:email:liquidacion": "tsx scripts/test-notifications.ts liquidacion",
		"test:email:admin": "tsx scripts/test-notifications.ts admin",
		"test:email:activation": "tsx scripts/test-notifications.ts activation",
		"test:email:integration": "vitest --config vitest.integration.config.ts --run src/features/email",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"chromatic": "npx chromatic --project-token=${CHROMATIC_PROJECT_TOKEN}",
		"chromatic:ci": "npx chromatic --exit-zero-on-changes --auto-accept-changes",
		"prisma:generate": "prisma generate",
		"prisma:migrate:dev": "prisma migrate dev",
		"prisma:migrate:deploy": "prisma migrate deploy",
		"prisma:studio": "prisma studio",
		"prisma:db:pull": "prisma db pull",
		"prisma:db:push": "prisma db push",
		"prisma:seed": "tsx prisma/seed.ts",
		"prisma:seed:agencia": "tsx prisma/seed-agencia.ts",
		"format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
		"format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
		"prepare": "husky"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1047.0",
		"@aws-sdk/s3-request-presigner": "^3.1047.0",
		"@date-fns/tz": "^1.4.1",
		"@flagsmith/flagsmith": "^12.0.1",
		"@hookform/resolvers": "^5.2.2",
		"@playwright/test": "^1.56.1",
		"@prisma/client": "^6.18.0",
		"@radix-ui/react-alert-dialog": "^1.1.15",
		"@radix-ui/react-avatar": "^1.1.10",
		"@radix-ui/react-checkbox": "^1.3.3",
		"@radix-ui/react-dialog": "^1.1.15",
		"@radix-ui/react-dropdown-menu": "^2.1.16",
		"@radix-ui/react-label": "^2.1.7",
		"@radix-ui/react-navigation-menu": "^1.2.14",
		"@radix-ui/react-popover": "^1.1.15",
		"@radix-ui/react-progress": "^1.1.7",
		"@radix-ui/react-radio-group": "^1.3.8",
		"@radix-ui/react-scroll-area": "^1.2.10",
		"@radix-ui/react-select": "^2.2.6",
		"@radix-ui/react-separator": "^1.1.7",
		"@radix-ui/react-slider": "^1.3.6",
		"@radix-ui/react-slot": "^1.2.4",
		"@radix-ui/react-switch": "^1.2.6",
		"@radix-ui/react-tabs": "^1.1.13",
		"@radix-ui/react-tooltip": "^1.2.8",
		"@sendgrid/mail": "^8.1.6",
		"@storybook/nextjs": "^9.1.3",
		"@tailwindcss/vite": "^4.1.15",
		"@tanstack/react-table": "^8.21.3",
		"bcryptjs": "^3.0.3",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"date-fns": "^4.3.0",
		"flagsmith-nodejs": "^8.1.0",
		"lucide-react": "^0.546.0",
		"next": "15.5.0",
		"next-auth": "^5.0.0-beta.30",
		"next-themes": "^0.4.6",
		"react": "19.1.0",
		"react-day-picker": "^10.0.1",
		"react-dom": "19.1.0",
		"react-hook-form": "^7.65.0",
		"recharts": "^3.8.1",
		"server-only": "^0.0.1",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.3.1",
		"tailwindcss-animate": "^1.0.7",
		"xlsx": "^0.18.5",
		"xlsx-js-style": "^1.2.0",
		"zod": "^4.1.12"
	},
	"devDependencies": {
		"@chromatic-com/storybook": "^4.1.1",
		"@eslint/eslintrc": "^3",
		"@storybook/addon-a11y": "^9.1.3",
		"@storybook/addon-docs": "^9.1.3",
		"@storybook/addon-onboarding": "^9.1.3",
		"@storybook/addon-vitest": "^9.1.3",
		"@storybook/nextjs-vite": "^9.1.3",
		"@tailwindcss/postcss": "^4.1.15",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.0",
		"@testing-library/user-event": "^14.6.1",
		"@types/bcryptjs": "^2.4.6",
		"@types/jest": "^30.0.0",
		"@types/node": "^20.19.23",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@types/xlsx": "^0.0.35",
		"@vitejs/plugin-react": "^5.1.0",
		"@vitest/browser": "3.2.4",
		"@vitest/coverage-v8": "3.2.4",
		"@vitest/ui": "^3.2.4",
		"autoprefixer": "^10.4.21",
		"eslint": "^9",
		"eslint-config-next": "15.5.0",
		"eslint-config-prettier": "^9.1.2",
		"eslint-plugin-storybook": "^9.1.3",
		"husky": "^9.1.7",
		"jest-environment-jsdom": "^30.2.0",
		"jsdom": "^26.1.0",
		"playwright": "^1.56.1",
		"prettier": "^3.6.2",
		"prisma": "^6.18.0",
		"storybook": "^9.1.3",
		"tailwindcss": "^4.0.0",
		"tsx": "^4.20.6",
		"typescript": "^5",
		"vitest": "^3.2.4"
	}
}
