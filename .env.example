# Local Development Environment Variables
# IMPORTANTE: Este archivo es gitignored - NO commitees credenciales reales
# Reemplaza con tus credenciales de Neon según docs/DATABASE_CONNECTION.md

# Application Environment
NODE_ENV=development

# Database Configuration - Neon (Desarrollo)
# Obtén la connection string desde: Neon Dashboard → Project → Connection Details
# Para Neon, puedes usar el mismo string para DATABASE_URL y DIRECT_URL
DATABASE_URL=
DIRECT_URL=

# Next.js Public API URL
NEXT_PUBLIC_API_URL=http://localhost:3000

# Additional Environment Variables
NEXT_TELEMETRY_DISABLED=1
PORT=3000
HOSTNAME=0.0.0.0

NEXTAUTH_SECRET=
# URL base de la app (sin barra final). En QA: https://negocios.qa.financieramentecu.co
# NEXTAUTH_URL=http://localhost:3000

# Detrás de proxy (Nginx): Auth.js debe confiar en el host de X-Forwarded-* (ver docs/DIAGNOSTIC_403_SIGNIN_QA_2026-02-04.md)
# AUTH_TRUST_HOST=true

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=
SENDGRID_TEMPLATE_ID=

# Optional: password for seeded system user agencia@financieramentecu.com (local login if ssoOnly is toggled)
# AGENCIA_USER_PASSWORD=

# DigitalOcean Spaces
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_ENDPOINT=
DO_SPACES_BUCKET=
DO_SPACES_PREFIX=