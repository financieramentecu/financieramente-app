# Local Development Environment Variables
# IMPORTANTE: Este archivo es gitignored - NO commitees credenciales reales
# Reemplaza con tus credenciales de Neon según docs/DATABASE_CONNECTION.md

# Application Environment
NODE_ENV=development

# Database Configuration - Neon (Desarrollo)
# Obtén la connection string desde: Neon Dashboard → Project → Connection Details
# Para Neon, puedes usar el mismo string para DATABASE_URL y DIRECT_URL
DATABASE_URL=
DIRECT_URL=

# Next.js Public API URL
NEXT_PUBLIC_API_URL=http://localhost:3000

# Additional Environment Variables
NEXT_TELEMETRY_DISABLED=1
PORT=3000
HOSTNAME=0.0.0.0

NEXTAUTH_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=
SENDGRID_TEMPLATE_ID=
