// Prisma Schema
// Sistema de Liquidación de Comisiones

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =====================================================
// TABLAS DE CATÁLOGOS Y DOMINIOS
// =====================================================

model Company {
  idCompany     Int      @id @default(autoincrement()) @map("id_company")
  name          String   @db.VarChar(100)
  idTypeCompany String   @map("id_type_company") @db.VarChar(20) // 'NACIONAL' o 'INTERNACIONAL'
  status        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relaciones
  products Product[]

  // Note: 'Aseguradoras: Skandia, Trinity, American Fidelity.'

  @@index([idTypeCompany])
  @@index([name])
  @@index([status])
  @@map("company")
}

model ClientOrigin {
  idClientOrigin Int      @id @default(autoincrement()) @map("id_client_origin")
  name           String   @db.VarChar(100)
  description    String?  @db.Text
  status         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relaciones
  businesses            Business[]
  productConfigurations ProductConfiguration[]

  @@map("client_origin")
}

model Category {
  idCategory   Int      @id @default(autoincrement()) @map("id_category")
  code         String   @unique @db.VarChar(20)
  name         String   @db.VarChar(50)
  typeCategory String   @map("type_category") @db.VarChar(20) // 'MMS', 'ALIADO' o 'TRINITY'
  descripcion  String?  @db.Text
  status       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relaciones
  users                                 User[]
  productConfigurations                 ProductConfiguration[]
  productPercentageCommissionCategories ProductPercentageCommissionCategory[]

  @@index([typeCategory])
  @@map("category")
}

model Role {
  idRole      Int      @id @default(autoincrement()) @map("id_role")
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(100)
  description String?  @db.Text
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relaciones
  users     User[]
  auditLogs AuditLog[]

  // Note: 'ASISTENTE_GERENCIA_OPERATIVA, ANALISTA_SOPORTE, AGENTE'

  @@map("role")
}

model BuyPeriodicity {
  idBuyPeriodicity Int      @id @default(autoincrement()) @map("id_buy_periodicity")
  name             String   @db.VarChar(50)
  active           Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // Relaciones
  businesses Business[]

  // Note: 'MENSUAL(1), TRIMESTRAL(3), SEMESTRAL(6), ANUAL(12)'

  @@map("buy_periodicity")
}

model Currency {
  idCurrency Int      @id @default(autoincrement()) @map("id_currency")
  name       String   @db.VarChar(50)
  symbol     String?  @db.VarChar(5)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // Relaciones
  businesses Business[]

  @@map("currency")
}

model TypeProduct {
  idTypeProduct Int      @id @default(autoincrement()) @map("id_type_product")
  name          String   @db.VarChar(200)
  description   String?  @db.Text
  status        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relaciones
  products Product[]

  @@map("type_product")
}

// =====================================================
// ENTIDADES PRINCIPALES
// =====================================================

model Product {
  idProduct     Int      @id @default(autoincrement()) @map("id_product")
  idCompany     Int      @map("id_company")
  name          String   @db.VarChar(200)
  description   String?  @db.Text
  idTypeProduct Int?     @map("id_type_product")
  status        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relaciones
  company               Company                @relation(fields: [idCompany], references: [idCompany])
  typeProduct           TypeProduct?           @relation(fields: [idTypeProduct], references: [idTypeProduct])
  productConfigurations ProductConfiguration[]

  @@unique([idCompany, name])
  @@index([idCompany])
  @@map("product")
}

model ProductConfiguration {
  id                                         Int      @id @default(autoincrement()) @map("id_product_configuration")
  idProduct                                  Int      @map("id_product")
  idClientOrigin                             Int      @map("id_client_origin")
  idCategory                                 Int      @map("id_category")
  code                                       String?  @db.VarChar(50)
  active                                     Boolean  @default(true) @map("active")
  idProductPercentageCommissionNewBusinesses Int?     @map("id_product_percentage_commission_new_businesses")
  createdAt                                  DateTime @default(now()) @map("created_at")
  updatedAt                                  DateTime @updatedAt @map("updated_at")

  // Relaciones
  product                                  Product                       @relation(fields: [idProduct], references: [idProduct])
  clientOrigin                             ClientOrigin                  @relation(fields: [idClientOrigin], references: [idClientOrigin])
  category                                 Category                      @relation(fields: [idCategory], references: [idCategory])
  productPercentageCommissionNewBusinesses ProductPercentageCommission?  @relation("PpcNewBusinesses", fields: [idProductPercentageCommissionNewBusinesses], references: [idProductPercentageCommission])
  productPercentageCommissions             ProductPercentageCommission[]

  @@unique([idProduct, idClientOrigin, idCategory])
  @@unique([idProductPercentageCommissionNewBusinesses])
  @@index([idProduct])
  @@index([idClientOrigin])
  @@index([idCategory])
  @@map("product_configuration")
}

model ProductPercentageCommission {
  idProductPercentageCommission Int      @id @default(autoincrement()) @map("id_product_percentage_commission")
  idProductConfiguration        Int      @map("id_product_configuration")
  description                   String?  @db.VarChar(255)
  active                        Boolean  @default(true)
  createdAt                     DateTime @default(now()) @map("created_at")
  updatedAt                     DateTime @updatedAt @map("updated_at")

  // Relaciones
  productConfiguration                  ProductConfiguration                  @relation(fields: [idProductConfiguration], references: [id])
  productConfigurationAsNewBusinesses   ProductConfiguration?                 @relation("PpcNewBusinesses")
  productPercentageCommissionCategories ProductPercentageCommissionCategory[]
  businesses                            Business[]

  // Note: 'Configuración maestra de porcentajes. Code está en ProductConfiguration.'

  @@index([idProductConfiguration])
  @@map("product_percentaje_commision")
}

model ProductPercentageCommissionCategory {
  id                            Int      @id @default(autoincrement())
  idCategory                    Int      @map("id_category")
  idProductPercentageCommission Int      @map("id_product_percentage_commission")
  porcentajeDistribucion        Decimal  @map("porcentaje_distribucion") @db.Decimal(5, 4)
  porcentajePortfolio           Decimal? @map("porcentaje_portfolio") @db.Decimal(5, 4)
  active                        Boolean  @default(true)
  createdAt                     DateTime @default(now()) @map("created_at")
  updatedAt                     DateTime @updatedAt @map("updated_at")

  // Relaciones
  category                    Category                    @relation(fields: [idCategory], references: [idCategory])
  productPercentageCommission ProductPercentageCommission @relation(fields: [idProductPercentageCommission], references: [idProductPercentageCommission])
  comissionDistributions      ComissionDistribution[]

  @@index([idCategory])
  @@index([idProductPercentageCommission])
  @@map("product_percentaje_commision_category")
}

model User {
  idUser         Int       @id @default(autoincrement()) @map("id_user")
  name           String    @db.VarChar(150)
  lastName       String?   @map("last_name") @db.VarChar(150)
  typeIdentity   String    @default("CC") @map("type_identity") @db.VarChar(10)
  identityNumber String?   @map("identity_number") @db.VarChar(20)
  email          String    @unique @db.VarChar(150)
  password       String?   @db.VarChar(255) // Contraseña hasheada (opcional, para login con credenciales)
  ssoOnly        Boolean   @default(true) @map("sso_only") // true = solo SSO, false = permite email/password
  phone          String?   @db.VarChar(30)
  idCategoria    Int?      @map("id_categoria")
  idRole         Int?      @map("id_role")
  idUserLeader   Int?      @map("id_user_leader")
  entryDate      DateTime  @map("entry_date") @db.Date
  retirementDate DateTime? @map("retirement_date") @db.Date
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // Relaciones recursivas y jerárquicas
  category        Category?        @relation(fields: [idCategoria], references: [idCategory])
  role            Role?            @relation(fields: [idRole], references: [idRole])
  leader          User?            @relation("UserLeader", fields: [idUserLeader], references: [idUser])
  subordinates    User[]           @relation("UserLeader")
  businesses      Business[]
  fileImports     FileImport[]
  auditLogs       AuditLog[]
  clawbacks       Clawback[]
  clawbackBalance ClawbackBalance?
  commissionDiscountsCreated CommissionDiscount[] @relation("DiscountCreatedBy")
  commissionDiscountsUpdated CommissionDiscount[] @relation("DiscountUpdatedBy")

  // Note: 'Coaches, líderes, seniors, juniors con jerarquía recursiva'

  // Constraint única parcial: solo aplica cuando ambos campos tienen valores
  @@unique([typeIdentity, identityNumber], name: "user_typeIdentity_identityNumber_key", map: "user_typeIdentity_identityNumber_key")
  @@index([typeIdentity])
  @@index([idUserLeader])
  @@index([idRole])
  @@map("user")
}

model Client {
  idClient       Int      @id @default(autoincrement()) @map("id_client")
  name           String   @db.VarChar(200)
  lastName       String?  @map("last_name") @db.VarChar(200)
  typeIdentity   String   @default("CC") @map("type_identity") @db.VarChar(10)
  identityNumber String   @map("identity_number") @db.VarChar(20)
  email          String?  @db.VarChar(150)
  phone          String?  @db.VarChar(30)
  direcction     String?  @db.VarChar(255)
  city           String?  @db.VarChar(100)
  country        String   @default("Colombia") @db.VarChar(50)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relaciones
  businesses Business[]

  @@unique([typeIdentity, identityNumber])
  @@index([identityNumber])
  @@map("client")
}

// =====================================================
// TRANSACCIONES Y OPERACIONES
// =====================================================

model FileImport {
  idFileImport         Int       @id @default(autoincrement()) @map("id_file_import")
  nameFile             String    @map("name_file") @db.VarChar(255)
  fileType             String?   @map("file_type") @db.VarChar(20)
  loadDate             DateTime  @default(now()) @map("load_date")
  idUser               Int       @map("id_user")
  totalRecord          Int       @default(0) @map("total_record")
  successRecord        Int       @default(0) @map("success_record")
  errorRecord          Int       @default(0) @map("error_record")
  sincronizadoRecord   Int       @default(0) @map("sincronizado_record")
  rezagadoRecord       Int       @default(0) @map("rezagado_record")
  noSincronizadoRecord Int       @default(0) @map("no_sincronizado_record")
  status               String    @db.VarChar(20) // 'PROCESSING', 'LOAD', 'COMPLETED', 'ERROR', 'CANCELLED', 'PRE-SETTLED', 'SETTLED'
  preLiquidacionDate   DateTime? @map("pre_liquidacion_date")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  // Relaciones
  user                  User                   @relation(fields: [idUser], references: [idUser])
  settlementCommissions SettlementCommission[]
  fileImportErrors      FileImportError[]

  @@index([loadDate])
  @@index([status])
  @@map("file_import")
}

model Business {
  idBusiness                    Int      @id @default(autoincrement()) @map("id_business")
  contract                      String?  @unique @db.VarChar(100)
  term                          Int?
  value                         Decimal  @db.Decimal(15, 2)
  observations                  String?  @db.Text
  idBuyPeriodicity              Int?     @map("id_buy_periodicity")
  idUser                        Int      @map("id_user")
  idClient                      Int      @map("id_client")
  idProductPercentageCommission Int      @map("id_product_percentage_commission")
  idCurrency                    Int      @map("id_currency")
  idClientOrigin                Int      @map("id_client_origin")
  status                        String?  @db.VarChar(20)
  createdAt                     DateTime @default(now()) @map("created_at")
  updatedAt                     DateTime @updatedAt @map("updated_at")

  // Relaciones
  user                        User                        @relation(fields: [idUser], references: [idUser])
  client                      Client                      @relation(fields: [idClient], references: [idClient])
  productPercentageCommission ProductPercentageCommission @relation(fields: [idProductPercentageCommission], references: [idProductPercentageCommission])
  currency                    Currency                    @relation(fields: [idCurrency], references: [idCurrency])
  buyPeriodicity              BuyPeriodicity?             @relation(fields: [idBuyPeriodicity], references: [idBuyPeriodicity])
  clientOrigin                ClientOrigin                @relation(fields: [idClientOrigin], references: [idClientOrigin])
  settlementCommissions       SettlementCommission[]

  // Note: 'Negocios de un usuario'

  @@index([idUser])
  @@index([contract])
  @@index([idClientOrigin])
  @@map("business")
}

// =====================================================
// LIQUIDACIÓN Y CÁLCULOS
// =====================================================

model CommissionDiscount {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(100)
  type        String   @db.VarChar(20) // 'IMPUESTO' | 'CLAWBACK'
  percentage  Decimal  @db.Decimal(5, 2)
  description String?  @db.Text
  status      String   @default("ACTIVE") @db.VarChar(20) // 'ACTIVE' | 'INACTIVE'
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdById Int?     @map("created_by_id")
  updatedById Int?     @map("updated_by_id")

  // Relaciones
  createdBy User? @relation("DiscountCreatedBy", fields: [createdById], references: [idUser])
  updatedBy User? @relation("DiscountUpdatedBy", fields: [updatedById], references: [idUser])

  @@index([status])
  @@index([type])
  @@map("commission_discount")
}


model SettlementCommission {
  idSettlementCommission Int     @id @default(autoincrement())
  idFileImport           Int     @map("id_file_import")
  idBusiness             Int?    @map("id_business")
  contract               String? @db.VarChar(50)

  // Campos del excel
  descripcion        String?
  commissionValue    Decimal?  @map("commission_value") @db.Decimal(15, 2)
  baseCommission     Decimal?  @map("base_commission") @db.Decimal(15, 2)
  discountPercentage Decimal?  @map("discount_percentage") @db.Decimal(5, 4)
  clawbackPercentage Decimal?  @map("clawback_percentage") @db.Decimal(5, 4)
  originCommission   String?   @map("origin_commission") @db.VarChar(20)
  commissionType     String    @map("commission_type") @db.VarChar(20)
  startDate          DateTime? @map("start_date")
  endDate            DateTime? @map("end_date")

  // Campos de control
  status     String    @default("PENDING") // PENDING, SYNCHRONIZED, LAG, PRE-SETTLED, SETTLED
  isLag      Boolean   @default(false) @map("is_lag")
  isClawback Boolean   @default(false) @map("is_clawback")
  lagDate    DateTime? @map("lag_date")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  // Relaciones
  fileImport FileImport @relation(fields: [idFileImport], references: [idFileImport])
  business   Business?  @relation(fields: [idBusiness], references: [idBusiness])

  comissionDistributions ComissionDistribution[]

  @@index([idFileImport])
  @@index([idBusiness])
  @@map("settlement_commission")
}

model ComissionDistribution {
  idComissionDistribution       Int      @id @default(autoincrement()) @map("id_comission_distribution")
  idSettlementCommission        Int      @map("id_settlement_comission")
  idPercentajeCommisionCategory Int?     @map("id_percentaje_commision_category")
  valueComission                Decimal  @map("value_comission") @db.Decimal(15, 2)
  valueComissionFinal           Decimal  @map("value_comission_final") @db.Decimal(15, 2)
  totalDiscount                 Decimal? @map("total_discount") @db.Decimal(15, 2)
  appliedDiscountPercentage     Decimal? @map("applied_discount_percentage") @db.Decimal(5, 4)
  observation                   String?  @db.Text
  status                        String   @db.VarChar(20) // 'LIQUIDADO', 'NOTIFICADO', 'PAGADA', 'ANULADA'
  createdAt                     DateTime @default(now()) @map("created_at")
  updatedAt                     DateTime @updatedAt @map("updated_at")

  // Relaciones
  settlementCommission                SettlementCommission                 @relation(fields: [idSettlementCommission], references: [idSettlementCommission])
  productPercentageCommissionCategory ProductPercentageCommissionCategory? @relation(fields: [idPercentajeCommisionCategory], references: [id])
  clawback                            Clawback?

  // Note: "El clawback es a nivel de negocio o por liquidación, Distribución detallada con clawback del 10% para Senior/Junior"

  @@index([idSettlementCommission])
  @@map("comission_distribution")
}

model Clawback {
  idClawback              Int       @id @default(autoincrement()) @map("id_clawback")
  idUser                  Int       @map("id_user")
  idComissionDistribution Int       @unique @map("id_comission_distribution")
  valueClawback           Decimal   @map("value_clawback") @db.Decimal(15, 2)
  porcentajeApplied       Decimal   @map("porcentaje_applied") @db.Decimal(5, 4)
  state                   String    @db.VarChar(20) // 'RETENIDO', 'LIBERADO', 'APLICADO', 'CANCELADO'
  appliedDate             DateTime? @map("applied_date") @db.Date
  releaseDate             DateTime? @map("release_date") @db.Date
  reason                  String?   @db.Text
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  // Relaciones
  user                  User                  @relation(fields: [idUser], references: [idUser])
  comissionDistribution ComissionDistribution @relation(fields: [idComissionDistribution], references: [idComissionDistribution])

  // Note: 'Histórico de retenciones clawback (90 días)'

  @@index([state])
  @@index([idUser])
  @@map("clawback")
}

model ClawbackBalance {
  idUser      Int      @id @map("id_user")
  totalAmount Decimal  @map("total_amount") @db.Decimal(15, 2)
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relaciones
  user User @relation(fields: [idUser], references: [idUser])

  @@map("clawback_balance")
}

// =====================================================
// AUDITORÍA Y SEGURIDAD
// =====================================================

model AuditLog {
  idAuditLog Int      @id @default(autoincrement()) @map("id_audit_log")
  idUser     Int?     @map("id_user")
  idRole     Int?     @map("id_role")
  action     String   @db.VarChar(50) // 'LOGIN', 'LOGOUT', 'ACCESS_DENIED', 'ACCOUNT_DISABLED'
  email      String?  @db.VarChar(150)
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  userAgent  String?  @map("user_agent") @db.Text
  details    String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  // Relaciones
  user User? @relation(fields: [idUser], references: [idUser])
  role Role? @relation(fields: [idRole], references: [idRole])

  @@index([idUser])
  @@index([idRole])
  @@index([action])
  @@index([email])
  @@index([createdAt])
  @@map("audit_log")
}

model FileImportError {
  idFileImportError Int     @id @default(autoincrement()) @map("id_file_import_error")
  idFileImport      Int     @map("id_file_import")
  rowNumber         Int     @map("row_number")
  contract          String? @db.VarChar(50)
  reason            String  @db.Text
  rawData           Json    @map("raw_data")

  // Relaciones
  fileImport FileImport @relation(fields: [idFileImport], references: [idFileImport])

  @@index([idFileImport])
  @@map("file_import_error")
}
